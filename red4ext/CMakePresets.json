{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CYBERCRAFT_DEPLOY_DIR": "$env{CYBERCRAFT_DEPLOY_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo"
    }
  ]
}
