{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [
    {
      "slug": "cyberpunk-2077",
      "role": "primary"
    },
    {
      "slug": "minecraft-java",
      "role": "companion"
    }
  ],
  "components": [
    {
      "id": "main",
      "fileName": "CyberCraftGame-*.zip",
      "label": "CyberCraft",
      "kind": "main",
      "required": true
    },
    {
      "id": "minecraft",
      "fileName": "CyberCraftMinecraft-*.zip",
      "label": "CyberCraft's Minecraft: portable Prism Launcher (GPL-3.0), Fabric API, e4mc",
      "kind": "extra",
      "required": true
    },
    {
      "id": "codeware",
      "fileName": "Codeware-*.zip",
      "label": "Codeware by psiberx (MIT): lights, colliders, third person, weather",
      "kind": "extra",
      "required": true
    },
    {
      "id": "modsettings",
      "fileName": "mod_settings_v*.zip",
      "label": "Mod Settings by jackhumbert (MIT): CyberCraft's options in the pause menu",
      "kind": "optional",
      "required": false
    }
  ],
  "requirements": [
    {
      "kind": "loader",
      "id": "red4ext"
    },
    {
      "kind": "loader",
      "id": "redscript"
    },
    {
      "kind": "loader",
      "id": "archivexl"
    }
  ],
  "mappings": [
    {
      "component": "main",
      "from": "archive/",
      "to": "{game}/archive"
    },
    {
      "component": "main",
      "from": "red4ext/",
      "to": "{game}/red4ext"
    },
    {
      "component": "minecraft",
      "from": "",
      "to": "{localappdata}/CyberCraft"
    },
    {
      "component": "codeware",
      "from": "red4ext/",
      "to": "{game}/red4ext"
    },
    {
      "component": "modsettings",
      "from": "red4ext/",
      "to": "{game}/red4ext"
    }
  ],
  "launch": {
    "kind": "exe",
    "path": "{game}/bin/x64/Cyberpunk2077.exe"
  },
  "setup": {
    "label": "Minecraft",
    "launch": {
      "kind": "exe",
      "path": "{localappdata}/CyberCraft/Prism/prismlauncher.exe"
    },
    "done": {
      "file": "{localappdata}/CyberCraft/Prism/accounts.json"
    },
    "stopWhenDone": true
  },
  "runtimeData": [
    "{localappdata}/CyberCraft"
  ],
  "notes": {
    "firstLaunch": "The first time, Melty signs CyberCraft's Minecraft in with the Microsoft account that owns Minecraft: Java Edition before the game starts. While Cyberpunk loads, Prism downloads Minecraft and Java in the background (a few minutes, once). Minecraft then runs hidden and takes over V once a save has loaded. Your world opens to friends by itself; turn off Open to friends in Mod Settings to keep it private.",
    "beforeInstall": "If you have CyberCraft: Portable Prism or CyberCraft: Friends installed, remove it first: they're older remixes of this mashup and put the same files in the game."
  },
  "multiplayer": {
    "maxPlayers": 100,
    "connect": {
      "address": {
        "log": "{localappdata}/CyberCraft/melty.log",
        "after": "Melty join address: "
      },
      "joinFile": {
        "path": "{localappdata}/CyberCraft/Prism/instances/CyberCraft/.minecraft/config/cybercraft.properties",
        "key": "join"
      }
    }
  }
}
